generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  VIEWER
}

model User {
  id                 String   @id @default(cuid())
  username           String   @unique
  email              String   @unique
  passwordHash       String
  role               Role     @default(USER)
  grantedPermissions String[] @default([])
  revokedPermissions String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions      Session[]
  conversations AIConversation[]
  auditLogs     AuditLog[]
  tasks         Task[]
  workspaces    Workspace[]
  applications  Application[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

enum NodeStatus {
  NEVER_CONNECTED
  ONLINE
  OFFLINE
}

model Node {
  id              String     @id @default(cuid())
  name            String     @unique
  description     String?
  tokenHash       String     @unique
  status          NodeStatus @default(NEVER_CONNECTED)
  platform        String?
  arch            String?
  osVersion       String?
  cpuModel        String?
  cpuCores        Int?
  totalMemoryMb   Int?
  totalDiskMb     Int?
  agentVersion    String?
  capabilities    Json?
  lastMetrics     Json?
  lastHeartbeatAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  applications Application[]
  workspaces   Workspace[]
}

model Application {
  id            String   @id @default(cuid())
  name          String
  type          String
  status        String   @default("creating")
  nodeId        String
  node          Node     @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  ports         Int[]    @default([])
  env           Json     @default("{}")
  config        Json     @default("{}")
  limits        Json     @default("{}")
  restartPolicy String   @default("on-crash")
  lastMetrics   Json?
  lastExitCode  Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  backups Backup[]
  tasks   Task[]

  @@unique([nodeId, name])
  @@index([type])
  @@index([status])
}

model Backup {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  status        String      @default("creating")
  sizeBytes     BigInt?
  error         String?
  createdAt     DateTime    @default(now())
  completedAt   DateTime?

  @@index([applicationId])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId    String
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations AIConversation[]

  @@index([userId])
}

model Task {
  id             String    @id @default(cuid())
  kind           String
  title          String
  status         String    @default("queued")
  progress       Int       @default(0)
  data           Json      @default("{}")
  result         Json?
  error          String?
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  applicationId  String?
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  conversationId String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  logs TaskLog[]

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

model TaskLog {
  id      String   @id @default(cuid())
  taskId  String
  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ts      DateTime @default(now())
  level   String   @default("info")
  message String

  @@index([taskId, ts])
}

model AIProvider {
  id          String   @id @default(cuid())
  kind        String
  displayName String
  apiKeyEnc   String?
  baseUrl     String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  models        AIModel[]
  conversations AIConversation[]
}

model AIModel {
  id          String     @id @default(cuid())
  providerId  String
  provider    AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modelId     String
  displayName String
  fetchedAt   DateTime   @default(now())

  @@unique([providerId, modelId])
}

model AIConversation {
  id           String     @id @default(cuid())
  name         String
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId   String
  provider     AIProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  model        String
  state        String     @default("idle")
  autonomyLevel String    @default("moderate")
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  systemPrompt String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  messages  AIMessage[]
  toolCalls AIToolCall[]

  @@index([userId, updatedAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  parts          Json           @default("[]")
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model AIToolCall {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolCallId     String
  name           String
  args           Json
  status         String
  result         Json?
  error          String?
  startedAt      DateTime       @default(now())
  finishedAt     DateTime?

  @@index([conversationId, startedAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  actor          String
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversationId String?
  action         String
  targetType     String?
  targetId       String?
  args           Json?
  success        Boolean
  error          String?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action])
}

model Domain {
  id            String   @id @default(cuid())
  name          String   @unique
  applicationId String?
  sslEnabled    Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
