# NexPanel environment configuration (all optional in development)

# PostgreSQL connection. Default: embedded dev database on port 5490.
DATABASE_URL=postgresql://nexpanel:nexpanel@127.0.0.1:5490/nexpanel

# Master secret (>= 32 chars). Auto-generated into the data dir if unset.
# ALWAYS set this explicitly in production.
#NEXPANEL_SECRET=change-me-to-a-long-random-string-please

# Control plane
#NEXPANEL_API_HOST=127.0.0.1
#NEXPANEL_API_PORT=4000
#NEXPANEL_DATA_DIR=
#NEXPANEL_TRUST_PROXY=false
#NEXPANEL_LOG_LEVEL=info

# Web UI
#NEXPANEL_WEB_PORT=3000
#NEXT_PUBLIC_API_PORT=4000

# Node agent (set by `nexpanel node register`, or via env)
#NEXPANEL_URL=http://127.0.0.1:4000
#NEXPANEL_NODE_TOKEN=npn_...
#NEXPANEL_AGENT_DATA=
